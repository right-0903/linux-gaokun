From f06daf3f8789aa00d1a9b8637b4daae28463ca0a Mon Sep 17 00:00:00 2001
From: Pengyu Luo <mitltlatltl@gmail.com>
Date: Fri, 1 May 2026 00:32:52 +0800
Subject: [PATCH] media: hi846: Fix link freq

These freqs are calculated when external clock is 24Mhz.

Signed-off-by: Pengyu Luo <mitltlatltl@gmail.com>
---
 drivers/media/i2c/hi846.c | 13 +++----------
 1 file changed, 3 insertions(+), 10 deletions(-)

diff --git a/drivers/media/i2c/hi846.c b/drivers/media/i2c/hi846.c
index 100ca805362f..a8bf1c20d262 100644
--- a/drivers/media/i2c/hi846.c
+++ b/drivers/media/i2c/hi846.c
@@ -1144,9 +1144,9 @@ static const char * const hi846_test_pattern_menu[] = {
 #define FREQ_INDEX_1280	1
 #define FREQ_INDEX_3264	2
 static const s64 hi846_link_freqs[] = {
-	[FREQ_INDEX_640] = 80000000,
-	[FREQ_INDEX_1280] = 200000000,
-	[FREQ_INDEX_3264] = 288000000,
+	[FREQ_INDEX_640] = 80000000,   /* unused for 24Mhz */
+	[FREQ_INDEX_1280] = 180000000, /* 24Mhz / 3 * 90 / 2 / 2 */
+	[FREQ_INDEX_3264] = 360000000, /* 24Mhz / 3 * 90 / 2 / 1 */
 };
 
 static const struct hi846_reg_list hi846_init_regs_list_2lane = {
@@ -2191,7 +2191,6 @@ static int hi846_probe(struct i2c_client *client)
 	struct hi846 *hi846;
 	int ret;
 	int i;
-	u32 mclk_freq;
 
 	hi846 = devm_kzalloc(&client->dev, sizeof(*hi846), GFP_KERNEL);
 	if (!hi846)
@@ -2210,12 +2209,6 @@ static int hi846_probe(struct i2c_client *client)
 				     "failed to get clock: %pe\n",
 				     hi846->clock);
 
-	mclk_freq = clk_get_rate(hi846->clock);
-	if (mclk_freq != 25000000)
-		dev_warn(&client->dev,
-			 "External clock freq should be 25000000, not %u.\n",
-			 mclk_freq);
-
 	for (i = 0; i < HI846_NUM_SUPPLIES; i++)
 		hi846->supplies[i].supply = hi846_supply_names[i];
 
-- 
2.54.0

